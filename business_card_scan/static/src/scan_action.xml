<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="business_card_scan.ScanAction">
        <div class="o_action o_bcs_scan h-100 overflow-auto">
            <div class="o_bcs_panel mx-auto px-3 py-4 py-md-5">

                <!-- En-tête -->
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="o_bcs_logo flex-shrink-0">
                        <i class="fa fa-id-card-o"/>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <h2 class="o_bcs_title mb-1">Scan a Business Card</h2>
                        <p class="text-muted mb-0">
                            Take a photo of a card, review the details, and create the lead in one click.
                        </p>
                    </div>
                    <button t-if="state.draftCount"
                            class="btn btn-light o_bcs_history d-none d-md-inline-flex align-items-center gap-2 flex-shrink-0"
                            t-on-click="openHistory">
                        <i class="fa fa-list-ul"/>
                        To Review
                        <span class="badge rounded-pill text-bg-warning" t-esc="state.draftCount"/>
                    </button>
                </div>

                <!-- Webcam (ordinateur) -->
                <div t-if="state.camera" class="o_bcs_camera"
                     t-att-class="{ 'o_bcs_camera_ready': state.cameraReady }">
                    <video t-ref="video" class="o_bcs_camera_video" autoplay="autoplay" muted="muted"
                           playsinline="playsinline" t-on-playing="onVideoReady"/>

                    <div t-if="!state.cameraReady" class="o_bcs_camera_loading">
                        <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
                        <span>Starting camera…</span>
                    </div>

                    <div class="o_bcs_camera_frame">
                        <span class="o_bcs_corner o_bcs_corner_tl"/>
                        <span class="o_bcs_corner o_bcs_corner_tr"/>
                        <span class="o_bcs_corner o_bcs_corner_bl"/>
                        <span class="o_bcs_corner o_bcs_corner_br"/>
                    </div>

                    <div class="o_bcs_camera_top">
                        <span class="o_bcs_camera_hint">
                            <i class="fa fa-id-card-o me-1"/> Fit the card inside the frame
                        </span>
                        <button class="o_bcs_camera_icon_btn" t-on-click="closeCamera"
                                title="Close" aria-label="Close">
                            <i class="fa fa-times"/>
                        </button>
                    </div>

                    <div class="o_bcs_camera_bar">
                        <button class="btn o_bcs_camera_ghost" t-on-click="closeCamera">Cancel</button>
                        <button class="o_bcs_shutter" t-on-click="capture" t-att-disabled="!state.cameraReady"
                                title="Capture" aria-label="Capture">
                            <span class="o_bcs_shutter_inner"/>
                        </button>
                        <div class="o_bcs_camera_end">
                            <button t-if="state.canSwitch" class="o_bcs_camera_icon_btn" t-on-click="switchCamera"
                                    title="Switch camera" aria-label="Switch camera">
                                <i class="fa fa-refresh"/>
                            </button>
                        </div>
                    </div>

                    <div t-if="state.flash" class="o_bcs_camera_flash"/>
                </div>

                <!-- Zone de capture -->
                <div t-if="!state.busy and !state.camera" class="o_bcs_dropzone"
                     t-att-class="{ 'o_bcs_dragging': state.dragging }"
                     t-on-dragover="onDragOver" t-on-dragleave="onDragLeave" t-on-drop="onDrop">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <button class="o_bcs_choice o_bcs_choice_primary w-100" t-on-click="openCamera">
                                <span class="o_bcs_choice_icon"><i class="fa fa-camera"/></span>
                                <span class="o_bcs_choice_label">Take a Photo</span>
                                <span class="o_bcs_choice_hint">Use your phone camera</span>
                            </button>
                        </div>
                        <div class="col-12 col-sm-6">
                            <button class="o_bcs_choice w-100" t-on-click="openFiles">
                                <span class="o_bcs_choice_icon"><i class="fa fa-cloud-upload"/></span>
                                <span class="o_bcs_choice_label">Upload Images</span>
                                <span class="o_bcs_choice_hint">One or several cards</span>
                            </button>
                        </div>
                    </div>
                    <div class="o_bcs_drop_hint text-center small text-muted mt-3 d-none d-md-block">
                        <i class="fa fa-hand-pointer-o me-1"/>
                        or drag and drop your photos here
                    </div>
                </div>

                <input type="file" accept="image/*" capture="environment" class="d-none"
                       t-ref="cameraInput" t-on-change="onFilesSelected"/>
                <input type="file" accept="image/*" multiple="multiple" class="d-none"
                       t-ref="fileInput" t-on-change="onFilesSelected"/>

                <!-- Traitement en cours -->
                <div t-if="state.busy" class="o_bcs_card o_bcs_progress_card">
                    <div class="d-flex flex-column flex-sm-row gap-3 align-items-sm-center">
                        <div class="o_bcs_preview_wrap flex-shrink-0">
                            <img t-if="state.preview" t-att-src="state.preview" class="o_bcs_preview" alt="Card"/>
                            <div t-else="" class="o_bcs_preview_placeholder">
                                <i class="fa fa-id-card-o"/>
                            </div>
                            <div t-if="state.step === 'read'" class="o_bcs_scanline"/>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                <strong class="text-truncate" t-esc="state.message"/>
                                <span t-if="state.total > 1" class="badge text-bg-light border ms-2 flex-shrink-0">
                                    Card <t t-esc="state.current"/> / <t t-esc="state.total"/>
                                </span>
                            </div>
                            <div class="progress o_bcs_progress mb-3" role="progressbar"
                                 t-att-aria-valuenow="state.progress" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar"
                                     t-att-class="{ 'progress-bar-striped progress-bar-animated': state.step !== 'read' }"
                                     t-att-style="'width: ' + (state.step === 'read' ? state.progress : 100) + '%'"/>
                            </div>
                            <ol class="o_bcs_steps list-unstyled d-flex gap-3 mb-0 small">
                                <li t-foreach="steps" t-as="step" t-key="step.key"
                                    t-att-class="'o_bcs_step_' + stepStatus(step.key)">
                                    <span class="o_bcs_step_dot">
                                        <i t-if="stepStatus(step.key) === 'done'" class="fa fa-check"/>
                                    </span>
                                    <t t-esc="step.label"/>
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>

                <!-- Conseils -->
                <div class="o_bcs_tips row g-3 mt-2">
                    <div class="col-12 col-md-4">
                        <div class="o_bcs_tip">
                            <i class="fa fa-lightbulb-o"/>
                            <div>
                                <strong>Good lighting</strong>
                                <span>Lay the card flat, well lit, without glare.</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="o_bcs_tip">
                            <i class="fa fa-crop"/>
                            <div>
                                <strong>Tight framing</strong>
                                <span>Only the card, held horizontally.</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="o_bcs_tip">
                            <i class="fa fa-files-o"/>
                            <div>
                                <strong>Batch import</strong>
                                <span>Upload many photos at once after a trade show.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 pt-3 border-top small text-muted">
                    <span>
                        <i class="fa fa-lock me-1"/>
                        Processed in your browser · free, no IAP credits
                    </span>
                    <button class="btn btn-link btn-sm p-0" t-on-click="openHistory">
                        View scanned cards <i class="fa fa-arrow-right ms-1"/>
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
